# Copiar a .env y completar. Nunca versionar .env.

# --- PostgreSQL ---
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=nexora
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_PORT=27017

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me

# --- Superset ---
SUPERSET_PORT=8088
# Generar con: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# --- Datos sintéticos ---
NEXORA_SEED=42
NEXORA_SCALE=demo

# --- Streaming (extensión) ---
REDPANDA_BROKERS=redpanda:9092

# --- Alertas (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
