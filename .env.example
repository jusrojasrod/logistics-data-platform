# Copiar a .env y completar. Nunca versionar .env.

# --- PostgreSQL ---
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexora
POSTGRES_PORT=5432
# DSN de etl_writer sin contraseña; la contraseña se toma de ETL_WRITER_PASSWORD.
NEXORA_PG_DSN=postgresql://etl_writer@postgres:5432/nexora

# --- Roles de base de datos ---
# Se aplican al crear el volumen de PostgreSQL. El valor va dentro de una URL
# de conexión: sin "@", ":" ni "/". Para cambiarlo después, ver la rotación de
# contraseñas en docs/07_runbook.md (make reset o ALTER ROLE).
AIRFLOW_PASSWORD=airflow_dev
SUPERSET_PASSWORD=superset_dev
ETL_WRITER_PASSWORD=etl_writer_dev
BI_READER_PASSWORD=bi_reader_dev
DQ_RUNNER_PASSWORD=dq_runner_dev
TMS_WRITER_PASSWORD=tms_writer_dev

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=nexora
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_PORT=27017
# Usuario de aplicación: readWrite solo en raw y meta (authSource=admin).
NEXORA_MONGO_APP_DSN=mongodb://nexora_app:change-me@mongo:27017/?authSource=admin
MONGO_APP_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me

# --- Superset ---
SUPERSET_PORT=8088
# Generar con: openssl rand -base64 42
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# --- Datos sintéticos ---
NEXORA_SEED=42
NEXORA_SCALE=demo

# --- API (mock TMS y fuentes externas) ---
# Puerto publicado en el host; el mock escucha en 8000 dentro del contenedor.
NEXORA_API_PORT=8090
# http://127.0.0.1:8090 en local; http://mock-api:8000 dentro de compose.
NEXORA_API_BASE_URL=http://127.0.0.1:8090
# Token Bearer de desarrollo del mock; sin secretos reales.
NEXORA_API_TOKEN=change-me
# 1 activa el drift determinista del mock (0 por defecto).
NEXORA_API_DRIFT=0
# 1 consulta las fuentes externas reales (0 usa el mock por defecto).
NEXORA_API_LIVE=0
# Carpeta de la caché de fuentes externas; en compose se sobrescribe con
# /opt/airflow/api_cache porque ./data se monta de solo lectura.
NEXORA_API_CACHE_DIR=data/tmp/api_cache
# Solo se usan con NEXORA_API_LIVE=1; sin proveedor real.
NEXORA_WEATHER_URL=
NEXORA_GEOCODING_URL=
NEXORA_EXCHANGE_RATE_URL=

# --- Streaming (extensión) ---
REDPANDA_BROKERS=redpanda:9092

# --- Alertas (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
